# Copy to .env and fill in. Never commit the real .env.

# Primary: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: main Gemini models in order; the next joins if nothing answers within 8 s
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
# Optional: faster, less detailed backup that joins at 44 s (set empty to skip)
# GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite

# Fallback when Gemini errors or is rate-limited: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional: a different Groq model for the text-only step (defaults to GROQ_MODEL)
# GROQ_TEXT_MODEL=
# Optional: Groq's free tier rejects requests that may write more than 1000 tokens per minute
# GROQ_MAX_TOKENS=1000
